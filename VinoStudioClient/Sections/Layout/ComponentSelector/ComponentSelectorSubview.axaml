<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:previewDialogue="clr-namespace:VinoStudioClient.Sections.Layout.ComponentSelector.PreviewComponents.Dialogue"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VinoStudioClient.Sections.Layout.ComponentSelector.ComponentSelectorSubview">

	<ScrollViewer VerticalScrollBarVisibility="Auto" Name="DraggableScroller">
				<StackPanel Spacing="10">
					<Border BorderBrush="#444"
							BorderThickness="2"
							Padding="10"
							CornerRadius="8"
							Name="DialoguePreview">
						<StackPanel>
							<TextBlock Text="Dialogue"
									   FontWeight="SemiBold"
									   FontSize="14"
									   Foreground="#444"
									   TextAlignment="Right"/>
							<previewDialogue:PreviewDialogueView />
						</StackPanel>
					</Border>

				</StackPanel>
	</ScrollViewer>
</UserControl>
