<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VinoStudioClient.Sections.Layout.ComponentPlacer.PreviewComponents.Dialogue.PreviewDialogueView">
	<StackPanel>
		<!-- Hero Name Block -->
		<Border Background="#333"
                CornerRadius="4"
                Padding="4"
                HorizontalAlignment="Left">
			<TextBlock Text="Hero Name"
                       FontWeight="Bold"
                       Foreground="LightBlue"
                       FontSize="14"/>
		</Border>

		<!-- Dialogue Box -->
		<Border Height="80"
                Opacity="0.8"
                Background="#222"
                CornerRadius="6"
                Padding="10">
			<TextBlock Text="Sample Dialogue Preview"
                       Foreground="Yellow"
                       FontSize="16"/>
		</Border>
	</StackPanel>
</UserControl>
